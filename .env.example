# Hashnode (CMS source)
# Your blog's host (e.g. the-learning-machine.hashnode.dev)
HASHNODE_HOST=your-blog.hashnode.dev
# Personal Access Token from https://hashnode.com/settings/developer
# Needed for MUTATIONS (publishing/updating). Public queries work without it
# once the publication is on Pro.
HASHNODE_TOKEN=your-personal-access-token
# GraphQL endpoint. Pro publications use gql-beta.hashnode.com (the default in
# code). The old gql.hashnode.com 301-redirects every request since the Pro
# gating (2026-05-13). Override here only if Hashnode changes the URL again.
# HASHNODE_ENDPOINT=https://gql-beta.hashnode.com

# Newsletter (Brevo)
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-api-key-here
BREVO_LIST_ID=your-list-id-here
BREVO_TEMPLATE_ID=5

# Analytics (Optional)
# Google Analytics - Get your tracking ID from https://analytics.google.com/
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Umami Analytics - Get your website ID from your Umami instance
PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# Disqus Comments (Optional)
# Get your shortname from https://disqus.com/admin/settings/general/
PUBLIC_DISQUS_SHORTNAME=your-shortname
